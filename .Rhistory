install.packages("car")
install.packages("lmtest")
knitr::opts_chunk$set(echo = TRUE)
library(datarium)    # Datos de marketing
library(clickR)      # Descriptivos avanzados
library(ggplot2)     # Gráficos generales
library(performance) # Gráficos de diagnóstico
library(see)         # Gráficos de diagnóstico
library(car)         # VIF
library(repmod)      # Tablas de resultados de modelos
library(nlme)        #Modificar estructura de la varianza
library(lattice)     #Gráfico normalidad
library(here)
library(readr)
library(MASS)
library(lmtest)
student_digital_life <- read_csv(here("dataset", "student_digital_life.csv"))
modelo_multivariable <- lm(final_exam_score ~ study_hours_per_day + sleep_hours + motivation_level,
data = student_digital_life)
summary(modelo_multivariable)
check_model(modelo_multivariable, check="linearity")
modelo_multivariable_corregido <- lm(log(final_exam_score) ~ study_hours_per_day + log(sleep_hours) + log(motivation_level), data = student_digital_life)
summary(modelo_multivariable_corregido)
modelo_multivariable_corregido <- lm(log(final_exam_score) ~ study_hours_per_day + log(sleep_hours) + log(motivation_level), data = student_digital_life)
plot(modelo_multivariable_corregido, 1)
modelo_multivariable_corregido <- lm(log(final_exam_score) ~ study_hours_per_day + log(sleep_hours) + log(motivation_level), data = student_digital_life)
plot(modelo_multivariable_corregido, 1) + title(main ="Despues de correccion")
modelo_multivariable_corregido <- lm(log(final_exam_score) ~ study_hours_per_day + log(sleep_hours) + log(motivation_level), data = student_digital_life)
plot(modelo_multivariable, 1) + title(main ="Antes de correccion")
plot(modelo_multivariable_corregido, 1) + title(main ="Despues de correccion")
